{
  "name": "@vanami/accounts-react",
  "version": "0.2.0",
  "description": "React components for Vanami accounts: sign-in button, account menu, and a provider for apps without a server (PKCE in the browser).",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js"
  },
  "peerDependencies": {
    "@vanami/accounts": "^0.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "@vanami/accounts": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanami/accounts-sdk.git",
    "directory": "react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
